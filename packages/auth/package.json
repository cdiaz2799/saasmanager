{
  "name": "@saasmanager/auth",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "auth:generate": "bun x --bun auth@1.7.3 generate --config ./auth-cli.config.ts --output ../db/src/schema/auth.generated.ts --yes"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.3",
    "@saasmanager/db": "workspace:*",
    "@saasmanager/env": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@saasmanager/config": "workspace:*",
    "@types/bun": "catalog:",
    "auth": "1.7.3",
    "typescript": "catalog:"
  }
}
