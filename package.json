{
  "name": "saasmanager",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.0",
      "elysia": "^1.4.29",
      "@orpc/server": "^1.14.12",
      "@orpc/openapi": "^1.14.12",
      "@orpc/zod": "^1.14.12",
      "better-auth": "1.7.3",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "@orpc/client": "^1.14.12",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.3"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate -F @saasmanager/db --",
    "db:migrate": "turbo run db:migrate -F @saasmanager/db --",
    "db:push": "turbo run db:push -F @saasmanager/db --",
    "db:studio": "turbo run db:studio -F @saasmanager/db --",
    "dev": "turbo run dev",
    "dev:server": "turbo run dev -F server --",
    "dev:web": "turbo run dev -F web --",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:up": "docker compose up -d --build",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@saasmanager/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@saasmanager/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.10.7"
  },
  "packageManager": "bun@1.3.14"
}
